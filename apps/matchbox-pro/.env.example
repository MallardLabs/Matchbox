# Server-only. Never prefix with NEXT_PUBLIC_.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Recommended for WalletConnect QR/mobile wallets. Browser extension wallets
# still work locally without it. Create one at https://cloud.walletconnect.com.
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# Optional overrides. Defaults use app.matchbox.markets and public Mezo RPCs.
MATCHBOX_DATA_BASE_URL=https://app.matchbox.markets
MEZO_RPC_URLS=

# Shows labeled fixtures only when the selected demo wallet has no live linked journeys.
STUART_DEMO_FALLBACK=true

# Comma-separated production/preview origins allowed to call /api/mcp from a browser.
MATCHBOX_MCP_ALLOWED_ORIGINS=
