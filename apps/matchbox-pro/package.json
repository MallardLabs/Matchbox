    "@tanstack/react-query": "^5.62.2",
    "@tanstack/react-router": "^1.168.5",
    "@thesis-co/cent": "^0.0.5",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
