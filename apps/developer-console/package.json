{
  "name": "@repo/developer-console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "lint": "biome check src/ vite.config.ts vitest.config.ts tailwind.config.ts",
    "lint:fix": "biome check --write src/ vite.config.ts vitest.config.ts tailwind.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p src/worker/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@repo/logger": "workspace:*",
    "@repo/platform-contracts": "workspace:*",
    "@repo/platform-server": "workspace:*",
    "@repo/ui": "workspace:*",
    "@simplewebauthn/browser": "^13.2.2",
    "@simplewebauthn/server": "^13.2.2",
    "@supabase/supabase-js": "^2.108.2",
    "@tanstack/react-query": "^5.62.2",
    "@tanstack/react-router": "^1.168.5",
    "hono": "^4.10.7",
    "lucide-react": "^1.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@cloudflare/vite-plugin": "^1.13.0",
    "@cloudflare/workers-types": "^4.20260620.1",
    "@repo/biome-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tanstack/router-plugin": "^1.167.10",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.13.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "wrangler": "^4.144.0"
  }
}
