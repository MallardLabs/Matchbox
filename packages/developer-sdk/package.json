{
  "name": "@matchbox-markets/sdk",
  "version": "1.0.0-beta.1",
  "description": "TypeScript client for the Matchbox API and Sign in with Matchbox (OIDC)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./oidc": {
      "import": {
        "types": "./dist/oidc.d.ts",
        "default": "./dist/oidc.js"
      },
      "require": {
        "types": "./dist/oidc.d.cts",
        "default": "./dist/oidc.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup && tsup --config tsup.cjs.config.ts",
    "generate": "tsx scripts/generate-types.ts",
    "lint": "biome check src/ scripts/",
    "lint:fix": "biome check --write src/ scripts/",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jose": "^6.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@repo/biome-config": "workspace:*",
    "@repo/platform-contracts": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24.13.2",
    "openapi-typescript": "^7.10.1",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
